# Copy to .env (gitignored) only if you want to override the compose defaults.
# Nothing here is a real secret. Secrets never go in a file in this repository.

# --- Frontend (put these in "ui components/.env.local", not here) -------------------------
# Where the Next.js proxy forwards /api/v1/* on the server. Points at the compose API by default.
API_ORIGIN=http://localhost:8080
# Judging day: the public URL printed by `make tunnel` (no trailing slash). Set it in the Vercel
# project's environment variables, and redeploy. Don't keep it in this file.
# API_ORIGIN=https://REPLACE-ME.trycloudflare.com

# --- Tunnel --------------------------------------------------------------------------------
# A reserved ngrok domain gives a URL that doesn't change between runs (needs a free ngrok account).
# NGROK_DOMAIN=REPLACE-ME.ngrok-free.app
