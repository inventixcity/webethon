# Dependencies and build output. The image installs and builds these itself.
node_modules
.next
out
*.tsbuildinfo
next-env.d.ts
# Generated by scripts/copy-maplibre-worker.mjs (build stage regenerates it)
public/vendor

# Env files: secrets and local config. Nothing in this group may enter the image.
.env*

# Version control, local tooling, deploy metadata
.git
.gitignore
.github
.claude
.vercel
.DS_Store
Dockerfile
.dockerignore

# Logs, screenshots, tests, coverage, artifacts (none are needed at runtime)
*.log
shots*
tests
artifacts
coverage

# Documentation is not needed at runtime
docs
