{
  "name": "invigil-browser-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent browser test suite for the invigil app. Uses playwright-core with the installed Microsoft Edge.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"specs/*.test.mjs\" \"unit/*.test.mjs\"",
    "unit": "node --test \"unit/*.test.mjs\"",
    "run": "node run.mjs"
  },
  "dependencies": {
    "playwright-core": "1.65.1"
  }
}
