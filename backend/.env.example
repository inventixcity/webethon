# Copy to backend/.env (gitignored) to run the API outside Docker: cargo run -p server -- serve
# These match crates/kernel/src/config.rs. Blank values mean "not set".
# Development values are fine locally. Production refuses to start unless it has what it needs.

# development (local rules) or production (strict: https origin, secure cookies, pepper, proxy secret)
APP_ENV=development

BIND_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9090
# Host port 55432 maps to the compose Postgres (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/invigil

# Public web origin. OAuth redirects and email links use it. https in production.
APP_ORIGIN=http://localhost:3000
# Extra origins allowed to send cookie-authenticated writes, comma-separated.
ALLOWED_ORIGINS=

# Keyed hash for email codes. Required in production (32+ characters). Generate: openssl rand -hex 24
CODE_PEPPER=

# Shared with the Next.js proxy, which signs the visitor IP. Required in production (32+ characters).
PROXY_SECRET=
# Trusted reverse proxies in front of the API (ingress-nginx is 1).
TRUSTED_PROXY_HOPS=0

SESSION_COOKIE=
SESSION_TTL_DAYS=30
# Blank: true in production, false in development. Plain HTTP localhost needs false.
SECURE_COOKIES=

# Mail. Use one of these. Development: SMTP_URL=smtp://localhost:1025 (mailpit).
EMAIL_FROM=Inventix Invigil <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025

# Comma-separated, lowercased on read.
ADMIN_EMAILS=

# Optional OAuth clients. Set both values of a pair together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional demo account for presentations.
DEMO_EMAIL=
DEMO_PASSWORD=

# Check passwords against the HIBP breach list (needs outbound HTTPS).
BREACH_CHECK=true

ENTITIES_PATH=config/entities.json
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECS=15

RUST_LOG=info,sqlx=warn
